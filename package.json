{
  "name": "vektor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run db:migrate:local && vp dev --host 127.0.0.1",
    "build": "vp build",
    "preview": "vp preview",
    "deploy": "void deploy --platform cloudflare",
    "prepare": "vp config",
    "postinstall": "void prepare",
    "preflight": "node scripts/ensure-dev-vars.mjs",
    "reset:d1": "node scripts/reset-local-d1.mjs",
    "seed:admin": "node scripts/seed-admin.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/ensure-void-wrangler.mjs && wrangler d1 migrations apply DB --local -c .void-wrangler.jsonc --persist-to .void",
    "db:migrate:remote": "node scripts/ensure-void-wrangler.mjs && wrangler d1 migrations apply DB --remote -c .void-wrangler.jsonc",
    "clean": "rm -rf .output .nitro .vinxi .tanstack .wrangler .void/v3 .vite .vitest coverage dist dist-ssr node_modules/.vite playwright-report playwright/.cache blob-report test-results",
    "test:smoke": "vp run preflight && vp run reset:d1 && vp build && playwright test",
    "test:tooling": "node --test scripts/ensure-void-wrangler.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "1.7.12",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "better-auth": "1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "void": "^1.1.12",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@12.14.0"
}
